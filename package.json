{
  "name": "aica-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "API Integration & Code Intelligence Agent",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --local",
    "build:web": "pnpm --filter aica-web build",
    "e2e": "pnpm --filter aica-web e2e",
    "db:link": "supabase link",
    "db:push:remote": "supabase db push",
    "db:pull:remote": "supabase db pull"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "supabase": "^2.116.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
