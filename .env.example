# Environment for the agent server.
#
# HOW THIS FILE IS USED
#
# It is not loaded automatically. Nothing here takes effect just because the
# file exists — that would mean a project's own .env being pulled into this
# process, and a tool that quietly harvests the secrets of the codebase it is
# analysing is not a tool anybody should run.
#
# Two ways to make these real:
#
#   1. Real environment variables, which is the normal path.
#        Windows:  setx OPENROUTER_API_KEY "sk-or-v1-..."   (then restart VS Code)
#        POSIX:    export OPENROUTER_API_KEY="sk-or-v1-..."
#
#   2. Point the server at a copy of this file:
#        setx AICA_ENV_FILE "C:\path\to\aica.env"
#
#      A variable already set in the real environment wins over the file, so a
#      single value can be overridden without editing anything.
#
# Configuration never contains a key. `agent.config.json` holds a *reference* —
# `env:NAME`, `keychain:NAME`, `file:path` or `prompt:NAME` — and a literal
# credential there is a validation failure rather than a leak. The names below
# are what those `env:` references resolve against.

# ---------------------------------------------------------------------------
# The model. The only key needed to make the agent write code.
# ---------------------------------------------------------------------------

# Referenced by `model.apiKeyRef`, which defaults to `env:OPENROUTER_API_KEY`.
# Leave it unset and everything except patch generation still works: indexing,
# the API catalog, impact analysis, planning and validation are deterministic.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# The model itself is configuration, not environment:
#   { "model": { "provider": "openrouter", "model": "anthropic/claude-sonnet-4.5" } }
# Set `provider` to "scripted" for a dry run with no network and no key.

# ---------------------------------------------------------------------------
# The database. Optional; off unless `database.enabled` is true.
# ---------------------------------------------------------------------------

# Must be the SECRET key (`sb_secret_...`), never the publishable one. Every
# table has row-level security with no policies, so the server bypasses RLS with
# the service role — a publishable key reads exactly zero rows, which looks like
# a broken database rather than the control working.
#
# Local:  docker inspect supabase_studio_aica \
#           --format '{{range .Config.Env}}{{println .}}{{end}}' \
#           | grep -oE "sb_secret_[A-Za-z0-9_-]+"
# Hosted: Project Settings -> API Keys
#
# Referenced by `database.serviceKeyRef`.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# ---------------------------------------------------------------------------
# The web dashboard. Optional.
# ---------------------------------------------------------------------------

# The server opens an HTTP port only when this is set. Every editor window that
# opens a folder starts a server, so a port on each of them — for a dashboard
# that may never be run — is a capability nobody asked for.
# AICA_HTTP_PORT=7333

# Printed to stderr on startup, generated per process. Set it only to pin a
# known value; a token in a file is a token in a repository.
# AICA_HTTP_TOKEN=

# What the dashboard reads to reach the server. Both are printed on startup.
# AICA_SERVER_URL=http://127.0.0.1:7333
# AICA_SERVER_TOKEN=

# Which project the dashboard shows when several are open. It discovers the
# first one otherwise, so this is only needed to disambiguate.
# AICA_PROJECT_ID=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# Referenced by `codingAgent.apiKeyRef` when `codingAgent.provider` is "jules".
# JULES_API_KEY=

# The Postman key does NOT belong here. It goes to the OS keychain:
#   VS Code -> "AICA: Set Postman API Key"
#   { "postman": { "apiKeyRef": "keychain:postman" } }

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

# debug | info | warn | error | silent. Server logs go to stderr, which the
# extension surfaces in its output channel; stdout is the protocol channel.
AICA_LOG_LEVEL=info

# Set both to run the live database contract tests, which skip otherwise.
# AICA_TEST_SUPABASE_URL=http://127.0.0.1:54321
# AICA_TEST_SUPABASE_SERVICE_KEY=sb_secret_...
