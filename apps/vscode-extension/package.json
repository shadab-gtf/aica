{
  "name": "aica-vscode",
  "displayName": "AICA — API Integration & Code Intelligence",
  "description": "Import an API, index the codebase, plan the integration, and validate the result.",
  "version": "0.1.1",
  "publisher": "ShadabChoudhary",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.0.0"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "categories": [
    "Programming Languages",
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "bundle": "node ./scripts/bundle.mjs",
    "package": "pnpm run build && pnpm run icon && pnpm run bundle && vsce package --no-dependencies",
    "icon": "node ./scripts/make-icon.mjs",
    "publish:marketplace": "vsce publish --no-dependencies"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aica",
          "title": "AICA",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aica": [
        {
          "id": "aica.apis",
          "name": "API Catalog"
        },
        {
          "id": "aica.plan",
          "name": "Plan"
        },
        {
          "id": "aica.validation",
          "name": "Validation"
        },
        {
          "id": "aica.changes",
          "name": "Proposed Changes"
        },
        {
          "id": "aica.timeline",
          "name": "Run Timeline"
        }
      ]
    },
    "commands": [
      {
        "command": "aica.chat",
        "title": "AICA: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aica.indexWorkspace",
        "title": "AICA: Index Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "aica.importApi",
        "title": "AICA: Import API Specification",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aica.importFromPostman",
        "title": "AICA: Import from Postman"
      },
      {
        "command": "aica.setPostmanKey",
        "title": "AICA: Set Postman API Key"
      },
      {
        "command": "aica.clearPostmanKey",
        "title": "AICA: Clear Postman API Key"
      },
      {
        "command": "aica.createPlan",
        "title": "AICA: Plan an Integration",
        "icon": "$(list-ordered)"
      },
      {
        "command": "aica.showPlanBrief",
        "title": "AICA: Show Plan Brief"
      },
      {
        "command": "aica.runValidation",
        "title": "AICA: Run Validation",
        "icon": "$(beaker)"
      },
      {
        "command": "aica.analyzeImpact",
        "title": "AICA: Analyze Impact of This File"
      },
      {
        "command": "aica.restartServer",
        "title": "AICA: Restart Agent Server"
      },
      {
        "command": "aica.showOutput",
        "title": "AICA: Show Agent Server Log"
      },
      {
        "command": "aica.run",
        "title": "AICA: Run a Task",
        "icon": "$(play)"
      },
      {
        "command": "aica.cancelRun",
        "title": "AICA: Cancel the Running Task",
        "icon": "$(stop)"
      },
      {
        "command": "aica.reviewChange",
        "title": "AICA: Review Proposed Change",
        "icon": "$(diff)"
      },
      {
        "command": "aica.applyChange",
        "title": "AICA: Apply Proposed Change",
        "icon": "$(check)"
      },
      {
        "command": "aica.revertChange",
        "title": "AICA: Revert Applied Change",
        "icon": "$(discard)"
      },
      {
        "command": "aica.discardChange",
        "title": "AICA: Discard Proposed Change",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aica.importApi",
          "when": "view == aica.apis",
          "group": "navigation"
        },
        {
          "command": "aica.indexWorkspace",
          "when": "view == aica.apis",
          "group": "navigation"
        },
        {
          "command": "aica.createPlan",
          "when": "view == aica.plan",
          "group": "navigation"
        },
        {
          "command": "aica.runValidation",
          "when": "view == aica.validation",
          "group": "navigation"
        },
        {
          "command": "aica.run",
          "when": "view == aica.changes",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "aica.analyzeImpact",
          "when": "editorLangId =~ /typescript|typescriptreact|javascript|javascriptreact/",
          "group": "aica@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aica.reviewChange",
          "when": "view == aica.changes && viewItem == aica.patch.proposed",
          "group": "inline@1"
        },
        {
          "command": "aica.applyChange",
          "when": "view == aica.changes && viewItem == aica.patch.proposed",
          "group": "inline@2"
        },
        {
          "command": "aica.discardChange",
          "when": "view == aica.changes && viewItem == aica.patch.proposed",
          "group": "inline@3"
        },
        {
          "command": "aica.revertChange",
          "when": "view == aica.changes && viewItem == aica.patch.applied",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "AICA",
      "properties": {
        "aica.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the agent server entry point. Left empty, the extension uses the server bundled with it."
        },
        "aica.server.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error",
            "silent"
          ],
          "default": "info",
          "description": "Log level for the agent server process. Its output appears in the AICA output channel."
        },
        "aica.index.onStartup": {
          "type": "boolean",
          "default": false,
          "description": "Index the workspace when the extension activates. Off by default: indexing a large repository is not instant, and it should be the user's choice when to pay for it."
        },
        "aica.index.maxFiles": {
          "type": "number",
          "default": 5000,
          "description": "Largest number of files indexed in one pass."
        },
        "aica.run.autoReviewOnPropose": {
          "type": "boolean",
          "default": true,
          "description": "Open the diff automatically when the agent proposes a change. Off means the change waits in the Proposed Changes view."
        }
      }
    }
  },
  "devDependencies": {
    "@aica/agent-server": "workspace:*",
    "@types/vscode": "~1.96.0",
    "@vscode/vsce": "^3.6.0"
  },
  "dependencies": {
    "@aica/rpc": "workspace:*",
    "@aica/schemas": "workspace:*",
    "@aica/shared": "workspace:*",
    "zod": "^3.25.76"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#101317",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shadab-gtf/aica.git"
  },
  "bugs": {
    "url": "https://github.com/shadab-gtf/aica/issues"
  },
  "homepage": "https://github.com/shadab-gtf/aica#readme",
  "keywords": [
    "api",
    "openapi",
    "postman",
    "code-intelligence",
    "agent",
    "refactoring",
    "mcp"
  ]
}
